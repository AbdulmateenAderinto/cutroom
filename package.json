{
  "name": "cutroom",
  "version": "0.1.0",
  "description": "A lightweight, local desktop video editor.",
  "private": true,
  "main": "build/main/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:export": "vitest run tests/integration",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs && node tests/e2e/smart.mjs && node tests/e2e/audio.mjs && node tests/e2e/photo.mjs && node tests/e2e/titles.mjs",
    "test:mcp": "npm run build && node tests/e2e/mcp.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && node tests/e2e/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.10.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
